{
  "name": "easing-scroll",
  "version": "1.1.0",
  "description": "♿️ Smooth scrolling",
  "type": "module",
  "types": "./dist/easing-scroll.d.ts",
  "main": "./dist/easing-scroll.cjs",
  "module": "./dist/easing-scroll.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/easing-scroll.d.ts",
        "default": "./dist/easing-scroll.js"
      },
      "require": {
        "types": "./dist/easing-scroll.d.cts",
        "default": "./dist/easing-scroll.cjs"
      },
      "default": "./dist/easing-scroll.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "check-types": "tsc",
    "build": "tsdown",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "preversion": "npm run check-types && npm test && npm run build",
    "prepack": "npm run build",
    "postversion": "git push && git push --tags && npm publish",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faustienf/easing-scroll.git"
  },
  "keywords": [
    "scroll",
    "smooth",
    "smooth-scroll",
    "easing"
  ],
  "author": "@faustienf",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "bugs": {
    "url": "https://github.com/faustienf/easing-scroll/issues"
  },
  "homepage": "https://github.com/faustienf/easing-scroll#readme",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
